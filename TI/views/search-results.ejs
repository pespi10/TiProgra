<!DOCTYPE html>
<html lang="es">
<!-- Include Head -->
<%- include("./partials/head.ejs")%>

<body>
	<!-- Header -->
	<%- include("./partials/header.ejs")%>
	<!-- /Header -->

	<!-- Novedades -->
	<div class="container products-wrapper">
		<div class="row">
			<div class="col-12">
				<h2 class="products-title">Resultados de búsqueda</h2>
			</div>
			<!-- Show the "ultimos" products -->
			<div class="col-12 col-sm-6 col-lg-3">
				<section class="product-box">
					<a href="/product/<%= productos[0].id %>">
						<figure class="product-box_image">
							<img src="<%= productos[0].imagen %>" alt="<%= productos[0].nombre %>">
						</figure>
						<article class="product-box_data">
							<h2><%= productos[0].nombre %></h2>
							<p><%= productos[0].descripcion %></p>
							<p>Comentarios: <%= productos[0].comentarios.length %></p>
						</article>
					</a>
				</section>
			</div>
		


	<!-- footer -->
	<%- include("./partials/footer") %>
	<!-- /footer -->
</body>

</html>