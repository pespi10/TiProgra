<!DOCTYPE html>
<html lang="es">
<!-- Include Head -->
<%- include("./partials/head.ejs")%>

<body>
	<!-- Header -->
	<%- include("./partials/header.ejs")%>
	<!-- /Header -->

	<!-- Resultados de búsqueda -->
	<div class="container products-wrapper">
		<div class="row">
			<div class="col-12">
				<h2 class="products-title">Resultados de búsqueda</h2>
			</div>

			<% if (mensaje) { %>
				<div class="col-12">
					<p><%= mensaje %></p>
				</div>
			<% } %>

			<% if (productos.length > 0) { %>
				<% productos.forEach(function(producto) { %>
					<div class="col-12 col-sm-6 col-lg-3">
						<section class="product-box">
							<a href="/products/product/<%= producto.id %>">
								<figure class="product-box_image">
									<img src="<%= producto.nombre_archivo_img %>" alt="<%= producto.nombre %>">
								</figure>
								<article class="product-box_data">
									<h2><%= producto.nombre %></h2>
									<p><%= producto.descripcion %></p>
									<p>
										Por: 
										<a href="/users/perfil/<%= producto.usuario.id %>">
											<%= producto.usuario.username %>
										</a>
									</p>
									
								</article>
							</a>
						</section>
					</div>
				<% }); %>
			<% } %>
		</div>
	</div>
	<!-- /Resultados -->

	<!-- footer -->
	<%- include("./partials/footer") %>
	<!-- /footer -->
</body>
</html>
