<!DOCTYPE html>
<html lang="es">
<!-- Include Head -->
<%- include("./partials/head.ejs")%>

<body>
	<!-- Header -->
	<% if (!locals.user) { %>
		<%- include("./partials/header.ejs") %>
	  <% } else {%>
		<%- include("./partials/headerLogeado.ejs") %>
	  <% } %>
	<!-- /Header -->

	<!-- Resultados de búsqueda -->
	<div class="container products-wrapper">
		<div class="row">
			<div class="col-12">
				<h2 class="products-title">Resultados de búsqueda</h2>
			</div>

			<% if (mensaje) { %>
				<div class="col-12">
					<p><%= mensaje %></p>
				</div>
			<% } %>

		
				<% for (let i = 0; i <  productos.length; i++) { %>		 
					<div class="col-12 col-sm-6 col-lg-3">
						<section class="product-box">
							<a href="/product/<%= productos[i].id %>">
								<figure class="product-box_image">
									<img src="<%= productos[i].nombreArchivoImg %>" alt="<%= productos[i].nombre %>">
								  </figure>
								  <article class="product-box_data">
									<ul>
									<li><h2><%= productos[i].nombre %></h2></li>
									<li><a href="users/perfil/<%=productos[i].usuarioId%>"><%= productos[i].users.email%></a></li>
									<li><p><%= productos[i].descripcion %></p></li>
									<li><p>Comentarios: 1</p></li>
									</ul>
								  </article>
						  </a>
						</section>
					  </div>
					  <% } %>
		
		</div>
	</div>
	<!-- /Resultados -->

	<!-- footer -->
	<%- include("./partials/footer") %>
	<!-- /footer -->
</body>
</html>
