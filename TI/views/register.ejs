<!DOCTYPE html>
<html lang="es">
<!-- Include Head -->

<%- include("./partials/head.ejs")%>

<body>
	<!-- Header -->
	<%- include("./partials/header.ejs")%>
	<!-- /Header -->

	<!-- Novedades -->
	<div class="container products-wrapper">
		<div class="row">
			<div class="col-12">
				<h2 class="products-title">Registrate</h2>
			</div>
			<!-- Show the "ultimos" products -->
			<h2 class="col-12">
				<form action="/users/newuser/" method="post">
				
				

				  <label for="mail">Email:</label>  <br>
				  <input type="email" id="mail" name="mail" required> <br> <br>
				  
				  <label for="username">Nombre de usuario:</label> <br>
				  <input type="text" name="username" id="username" required /> <br> <br>
				  
				  <label for="password">Contraseña:</label><br>
				  <input type="password" id="password" name="password" required minlength="3"> <br> <br>
				  

				  <label for="fecha">Fecha de Nacimiento:</label><br>

				  <input type="date" id="fecha" name="fecha" required><br> <br>
				  
				  <label for="dni">Nro de Documento:</label>
				  <br>
				  <input type="number" id="dni" name="dni" required><br>
				  <br>
				  
				  <label for="foto">Foto de Perfil (URL):</label>
				  <br>
				  <input type="text" id="foto" name="foto"><br>
				  <br>
				  
				  <button type="submit">Registrarse</button>
				
				</form>
			</h2>


	<!-- footer -->
	<%- include("./partials/footer") %>
	<!-- /footer -->
</body>

</html>