<!DOCTYPE html>
<html lang="es">
<!-- Include Head -->
<%- include("./partials/head.ejs")%>
<body>
	<!-- Header -->
	<% if (!locals.user) { %>
		<%- include("./partials/header.ejs") %>
	  <% } else {%>
		<%- include("./partials/headerLogeado.ejs") %>
	  <% } %>
	<!-- /Header -->
	
	<!-- product detail -->
	<div class="container products-wrapper">
		<div class="d-flex align-items-center">
			<h2 class="products-title"><%= producto.nombre %></h2> 
			<p class="product-detail-description">
				<a href="/product/productAdd">Editar</a>
			</p>
		</div>
		<div class="product-detail">
			<div class="row">
				<article class="col-12 col-lg-8 product-detail-info">
					<img src="<%= producto.nombreArchivoImg %>" alt="" class="product-detail-img">
					<p class="product-detail-description"><%= producto.descripcion %></p>
					<a href="/users/perfil/<%= producto.users.id %>"><%= producto.users.email %></a>
				</article>
				<div class="col-12 col-lg-4">
					<section class="comments">
						<% for( let i = 0; i < producto.comentarios.length; i++ ) { %>
							<article>
								<img src="<%= producto.comentarios[i].users.foto %>" alt="">
								<div class="data">
									<p class="user">
									<strong> <a href="/users/perfil/<%= producto.comentarios[i].users.id %>"><%= producto.comentarios[i].users.email %>: </a> </strong>
									 <%= producto.comentarios[i].texto %> </p>
								</div>
							</article>
						<% } %>
					</section>
						
					<form class="form" action="" method="POST">
						<input class="form-input" type="text" value="" placeholder="Agregar comentario">
						<button type="submit" class="buy-now-button">AGREGAR COMENTARIO</button>
					</form>
						
					<hr>
				</div>
			</div>
		</div>
	</div>
	<!-- /product detail -->

	<!-- footer -->
	<%- include("./partials/footer") %>
	<!-- /footer -->

</body>	
</html>