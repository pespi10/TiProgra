<!DOCTYPE html>
<html lang="es">
<!-- Include Head -->
<%- include("./partials/head.ejs")%>
<body>
	<!-- Header -->
	<%- include("./partials/header.ejs")%>
	<!-- /Header -->
	
	<!-- product detail -->
	<div class="container products-wrapper">
		<div class="d-flex align-items-center">
			<h2 class="products-title">Nombre del producto</h2> 
			<p class="product-detail-description">
				<a href="/productAdd">Editar</a>
			</p>
		</div>
		<div class="product-detail">
			<div class="row">
				<article class="col-12 col-lg-8 product-detail-info">
					<img src=<%= productos[0].imagen %> alt="" class="product-detail-img">
					<p class="product-detail-description"><%= productos[0].descripcion %></p>
				</article>
				<div class="col-12 col-lg-4">
					<section class="comments">
						<article>
							<img src=<%= productos[0].comentarios[0].imagenPerfil %> alt="">
							<div class="data">
								<p class="user">
								<strong> <a href="/profile"><%= productos[0].comentarios[0].usuario %>: </a> </strong>
								 <%= productos[0].comentarios[0].userComment %> </p>
							</div>
						</article>
						<article>
							<img src=<%= productos[0].comentarios[1].imagenPerfil %> alt="">
							<div class="data">
								<p class="user">
									<strong> <a href="/profile"><%= productos[0].comentarios[1].usuario %>: </a> </strong>
									<%= productos[0].comentarios[1].userComment %>.</p>
							</div>
						</article>
						<article>
							<img src=<%= productos[0].comentarios[2].imagenPerfil %> alt="">
							<div class="data">
								<p class="user">
									<strong> <a href="/profile"><%= productos[0].comentarios[2].usuario %>: </a> </strong>
									<%= productos[0].comentarios[2].userComment %> 
									</p>
							</div>
						</article>

					</section>
					<form class="form" action="" method="POST">
						<input class="form-input" type="text" value="" placeholder="Agregar comentario">
						<button type="submit" class="buy-now-button">AGREGAR COMENTARIO</button>
					</form>
					<hr>
				</div>
			</div>
		</div>
	</div>
	<!-- /product detail -->

	<!-- footer -->
	<%- include("./partials/footer") %>
	<!-- /footer -->

</body>	
</html>